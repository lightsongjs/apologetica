---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allTopics = await getCollection('conversations');

const groups = [
  { slug: 'atheist', name: 'Ateu', icon: 'psychology_alt' },
  { slug: 'baptist', name: 'Baptist', icon: 'church' },
  { slug: 'martorii-lui-iehova', name: 'Martor al lui Iehova', icon: 'groups' },
  { slug: 'catehumen', name: 'Catehumen', icon: 'school' },
];

const topicCounts = groups.map((g) => ({
  ...g,
  count: allTopics.filter((t) => t.data.denomination === g.slug).length,
}));
---

<Base title="Conversații" headerTitle="Apologetica" backHref="/" activeNav="home" activeTab="discutii">
  <!-- Search Bar -->
  <div class="mb-6 flex flex-col items-center">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
      <input
        type="text"
        id="search-input"
        placeholder="Caută conversații..."
        class="w-full bg-slate-50 dark:bg-[#1A1A1E] border border-slate-200 dark:border-[#2A2A2E] rounded-xl py-2 pl-10 pr-10 text-xs focus:ring-1 focus:ring-primary/20 focus:border-primary/30 focus:bg-white dark:focus:bg-[#16161A] transition-all placeholder:text-slate-400"
      />
      <button id="search-clear" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary p-1 rounded-full hover:bg-primary/10 transition-colors">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>
  </div>

  <!-- Denomination Cards -->
  <div id="cards-grid" class="grid grid-cols-1 gap-3">
    {topicCounts.map((group) => (
      <a
        href={`/conversatii/${group.slug}`}
        class="item-card flex bg-white dark:bg-[#16161A] border border-slate-100 dark:border-[#2A2A2E] rounded-lg overflow-hidden hover:shadow-md transition-shadow duration-300"
        data-name={group.name.toLowerCase()}
      >
        {/* Icon */}
        <div class="w-[80px] h-[80px] shrink-0 flex items-center justify-center p-2">
          <div class="w-full h-full rounded-2xl bg-slate-50 dark:bg-[#1A1A1E] flex items-center justify-center">
            <span class="material-symbols-outlined text-3xl text-primary/30 dark:text-[#c4d0fd]/30">{group.icon}</span>
          </div>
        </div>

        {/* Content */}
        <div class="p-2.5 flex flex-col justify-center min-w-0 flex-1">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-primary dark:text-[#c4d0fd] truncate">{group.name}</h2>
            <span class="material-symbols-outlined text-lg text-slate-300 dark:text-[#2A2A2E] shrink-0 ml-2">chevron_right</span>
          </div>
          <p class="text-on-surface-variant dark:text-[#6B6B70] text-[11px] leading-tight">
            {group.count} {group.count === 1 ? 'conversație' : 'conversații'}
          </p>
        </div>
      </a>
    ))}
  </div>

  <!-- No Results -->
  <div id="no-results" class="hidden text-center py-12">
    <span class="material-symbols-outlined text-primary/20 text-5xl mb-3">search_off</span>
    <p class="text-sm text-slate-500">Nicio conversație găsită</p>
  </div>

  <script is:inline>
    (function() {
      var searchInput = document.getElementById('search-input');
      var searchClearBtn = document.getElementById('search-clear');
      var cards = document.querySelectorAll('.item-card');
      var noResults = document.getElementById('no-results');

      searchInput?.addEventListener('input', function() {
        var query = searchInput.value.toLowerCase().trim();
        var visibleCount = 0;

        if (searchInput.value.trim()) {
          searchClearBtn?.classList.remove('hidden');
        } else {
          searchClearBtn?.classList.add('hidden');
        }

        cards.forEach(function(card) {
          var name = card.dataset.name || '';
          if (name.includes(query)) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0 && query !== '') {
          noResults?.classList.remove('hidden');
        } else {
          noResults?.classList.add('hidden');
        }
      });

      searchClearBtn?.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchClearBtn.classList.add('hidden');
        searchInput?.focus();
      });
    })();
  </script>
</Base>
