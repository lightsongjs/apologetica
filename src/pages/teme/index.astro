---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allTeme = await getCollection('teme');
// Filter to show only root themes (no parent)
const teme = allTeme.filter(tema => !tema.data.parent);
const sorted = teme.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ro'));

// Map themes to icons based on common topics
const themeIcons = {
  'apologetica': 'shield',
  'denominatii': 'account_balance',
  'erezii-si-sinoade': 'gavel',
  'scriptura': 'menu_book',
  'istorie-biblica': 'history_edu',
  'rugaciune': 'self_improvement',
  'sfanta-cruce': 'add',
  'sfintele-taine': 'auto_awesome',
  'cult-si-rit': 'local_fire_department',
};
---

<Base title="Teme" headerTitle="Apologetica" backHref="/" activeNav="home" activeTab="teme">
  <!-- Search Bar -->
  <div class="mb-6 flex flex-col items-center">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
      <input
        type="text"
        id="search-input"
        placeholder="Caută teme..."
        class="w-full bg-slate-50 dark:bg-[#1A1A1E] border border-slate-200 dark:border-[#2A2A2E] rounded-xl py-2 pl-10 pr-10 text-xs focus:ring-1 focus:ring-primary/20 focus:border-primary/30 focus:bg-white dark:focus:bg-[#16161A] transition-all placeholder:text-slate-400"
      />
      <button id="search-clear" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary p-1 rounded-full hover:bg-primary/10 transition-colors">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>
  </div>

  <!-- Teme List -->
  <div id="cards-grid" class="grid grid-cols-1 gap-3">
    {sorted.map((tema) => {
      const slug = tema.id.replace('.md', '');
      const icon = themeIcons[slug] || 'auto_stories';
      const hasImage = tema.data.image;
      return (
        <a
          href={`/teme/${slug}`}
          class="item-card flex bg-white dark:bg-[#16161A] border border-slate-100 dark:border-[#2A2A2E] rounded-lg overflow-hidden hover:shadow-md transition-shadow duration-300"
          data-title={tema.data.title.toLowerCase()}
          data-summary={tema.data.summary.toLowerCase()}
        >
          {/* Icon or Image */}
          <div class="w-[80px] h-[80px] shrink-0 flex items-center justify-center p-2">
            {hasImage ? (
              <div class="w-full h-full rounded-2xl overflow-hidden bg-slate-100 dark:bg-[#1A1A1E]">
                <img src={tema.data.image} alt="" class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              <div class="w-full h-full rounded-2xl bg-slate-50 dark:bg-[#1A1A1E] flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl text-primary/30 dark:text-[#c4d0fd]/30">{icon}</span>
              </div>
            )}
          </div>

          {/* Content */}
          <div class="p-2.5 flex flex-col justify-center min-w-0 flex-1">
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-bold text-primary dark:text-[#c4d0fd] truncate">{tema.data.title}</h2>
              <span class="material-symbols-outlined text-lg text-slate-300 dark:text-[#2A2A2E] shrink-0 ml-2">chevron_right</span>
            </div>
            <p class="text-on-surface-variant dark:text-on-surface-variant text-[11px] leading-tight line-clamp-2">{tema.data.summary}</p>
          </div>
        </a>
      );
    })}
  </div>

  <!-- No Results -->
  <div id="no-results" class="hidden text-center py-12">
    <span class="material-symbols-outlined text-primary/20 text-5xl mb-3">search_off</span>
    <p class="text-sm text-slate-500">Nicio temă găsită</p>
  </div>

  <script is:inline>
    (function() {
      var searchInput = document.getElementById('search-input');
      var searchClearBtn = document.getElementById('search-clear');
      var cards = document.querySelectorAll('.item-card');
      var noResults = document.getElementById('no-results');

      searchInput?.addEventListener('input', function() {
        var query = searchInput.value.toLowerCase().trim();
        var visibleCount = 0;

        if (searchInput.value.trim()) {
          searchClearBtn?.classList.remove('hidden');
        } else {
          searchClearBtn?.classList.add('hidden');
        }

        cards.forEach(function(card) {
          var title = card.dataset.title || '';
          var summary = card.dataset.summary || '';

          if (title.includes(query) || summary.includes(query)) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0 && query !== '') {
          noResults?.classList.remove('hidden');
        } else {
          noResults?.classList.add('hidden');
        }
      });

      searchClearBtn?.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchClearBtn.classList.add('hidden');
        searchInput?.focus();
      });
    })();
  </script>
</Base>
