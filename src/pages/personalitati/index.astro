---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const personalitati = await getCollection('personalitati');
const sorted = personalitati.sort((a, b) => {
  return a.data.name.localeCompare(b.data.name, 'ro');
});

const BATCH_SIZE = 50;
const initial = sorted.slice(0, BATCH_SIZE);
const remaining = sorted.slice(BATCH_SIZE).map(p => ({
  slug: p.id.replace('.md', ''),
  name: p.data.name,
  title: p.data.title,
  image: p.data.image,
}));
---

<Base title="Personalități" headerTitle="Apologetica" backHref="/" activeNav="home" activeTab="persoane">
  <!-- Search Bar -->
  <div class="mb-6 flex flex-col items-center">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
      <input
        type="text"
        id="search-input"
        placeholder="Caută personalități..."
        class="w-full bg-slate-50 dark:bg-[#1A1A1E] border border-slate-200 dark:border-[#2A2A2E] rounded-xl py-2 pl-10 pr-10 text-xs focus:ring-1 focus:ring-primary/20 focus:border-primary/30 focus:bg-white dark:focus:bg-[#16161A] transition-all placeholder:text-slate-400"
      />
      <button id="search-clear" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary p-1 rounded-full hover:bg-primary/10 transition-colors">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>
  </div>

  <!-- Cards List -->
  <div id="cards-grid" class="grid grid-cols-1 gap-3">
    {initial.map((p) => {
      const slug = p.id.replace('.md', '');
      return (
        <a
          href={`/personalitati/${slug}`}
          class="item-card flex bg-white dark:bg-[#16161A] border border-slate-100 dark:border-[#2A2A2E] rounded-lg overflow-hidden hover:shadow-md transition-shadow duration-300"
          data-name={p.data.name.toLowerCase()}
          data-title={p.data.title.toLowerCase()}
        >
          <div class="w-[80px] h-[80px] shrink-0 flex items-center justify-center p-2">
            <div class="w-full h-full rounded-2xl overflow-hidden bg-slate-100 dark:bg-[#1A1A1E] relative">
              <span class="material-symbols-outlined text-3xl text-slate-300 dark:text-[#2A2A2E] absolute inset-0 w-full h-full flex items-center justify-center">person</span>
              <img
                src={p.data.image}
                alt=""
                class="w-full h-full object-cover relative z-10"
                loading="lazy"
                onerror="this.style.display='none';"
              />
            </div>
          </div>
          <div class="p-2.5 flex flex-col justify-center min-w-0">
            <h2 class="text-sm font-bold text-primary dark:text-[#c4d0fd] truncate">{p.data.name}</h2>
            <p class="text-on-surface-variant dark:text-[#6B6B70] text-[11px] leading-tight line-clamp-2">{p.data.title}</p>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Scroll sentinel + loading spinner -->
  <div id="scroll-sentinel" class="h-1"></div>
  <div id="loading-spinner" class="hidden flex justify-center py-6">
    <span class="material-symbols-outlined text-primary/40 text-2xl animate-spin">progress_activity</span>
  </div>

  <!-- No Results -->
  <div id="no-results" class="hidden text-center py-12">
    <span class="material-symbols-outlined text-primary/20 text-5xl mb-3">search_off</span>
    <p class="text-sm text-slate-500">Nicio personalitate găsită</p>
  </div>

  <script is:inline define:vars={{ remaining, BATCH_SIZE }}>
    (function() {
      var grid = document.getElementById('cards-grid');
      var searchInput = document.getElementById('search-input');
      var searchClearBtn = document.getElementById('search-clear');
      var noResults = document.getElementById('no-results');
      var sentinel = document.getElementById('scroll-sentinel');
      var spinner = document.getElementById('loading-spinner');

      // All card data for search (initial cards from DOM + remaining from JSON)
      var allCards = [];
      var initialCards = grid.querySelectorAll('.item-card');
      initialCards.forEach(function(card) {
        allCards.push({ el: card, name: card.dataset.name, title: card.dataset.title });
      });

      var loadedIndex = 0;
      var isSearching = false;

      function createCard(p) {
        var a = document.createElement('a');
        a.href = '/personalitati/' + p.slug;
        a.className = 'item-card flex bg-white dark:bg-[#16161A] border border-slate-100 dark:border-[#2A2A2E] rounded-lg overflow-hidden hover:shadow-md transition-shadow duration-300';
        a.dataset.name = p.name.toLowerCase();
        a.dataset.title = p.title.toLowerCase();
        a.innerHTML = '<div class="w-[80px] h-[80px] shrink-0 flex items-center justify-center p-2">'
          + '<div class="w-full h-full rounded-2xl overflow-hidden bg-slate-100 dark:bg-[#1A1A1E] relative">'
          + '<span class="material-symbols-outlined text-3xl text-slate-300 dark:text-[#2A2A2E] absolute inset-0 w-full h-full flex items-center justify-center">person</span>'
          + '<img src="' + p.image + '" alt="" class="w-full h-full object-cover relative z-10" loading="lazy" onerror="this.style.display=\'none\';">'
          + '</div></div>'
          + '<div class="p-2.5 flex flex-col justify-center min-w-0">'
          + '<h2 class="text-sm font-bold text-primary dark:text-[#c4d0fd] truncate">' + p.name + '</h2>'
          + '<p class="text-on-surface-variant dark:text-[#6B6B70] text-[11px] leading-tight line-clamp-2">' + p.title + '</p>'
          + '</div>';
        return a;
      }

      function loadNextBatch() {
        if (loadedIndex >= remaining.length) return false;
        var end = Math.min(loadedIndex + BATCH_SIZE, remaining.length);
        var fragment = document.createDocumentFragment();
        for (var i = loadedIndex; i < end; i++) {
          var card = createCard(remaining[i]);
          if (isSearching) card.style.display = 'none';
          fragment.appendChild(card);
          allCards.push({ el: card, name: remaining[i].name.toLowerCase(), title: remaining[i].title.toLowerCase() });
        }
        grid.appendChild(fragment);
        loadedIndex = end;
        return loadedIndex < remaining.length;
      }

      // Infinite scroll
      var observer = new IntersectionObserver(function(entries) {
        if (!entries[0].isIntersecting || isSearching) return;
        spinner?.classList.remove('hidden');
        var hasMore = loadNextBatch();
        spinner?.classList.add('hidden');
        if (!hasMore) observer.disconnect();
      }, { rootMargin: '300px' });

      if (sentinel && remaining.length > 0) {
        observer.observe(sentinel);
      }

      // Search — loads ALL remaining cards first so search covers everything
      searchInput?.addEventListener('input', function() {
        var query = searchInput.value.toLowerCase().trim();
        isSearching = query !== '';
        var visibleCount = 0;

        if (searchInput.value.trim()) {
          searchClearBtn?.classList.remove('hidden');
        } else {
          searchClearBtn?.classList.add('hidden');
        }

        // Ensure all cards exist in DOM for search
        if (isSearching && loadedIndex < remaining.length) {
          while (loadedIndex < remaining.length) { loadNextBatch(); }
          observer.disconnect();
        }

        for (var i = 0; i < allCards.length; i++) {
          var c = allCards[i];
          if (isSearching) {
            if (c.name.includes(query) || c.title.includes(query)) {
              c.el.style.display = 'flex';
              visibleCount++;
            } else {
              c.el.style.display = 'none';
            }
          } else {
            c.el.style.display = '';
            visibleCount++;
          }
        }

        if (visibleCount === 0 && isSearching) {
          noResults?.classList.remove('hidden');
        } else {
          noResults?.classList.add('hidden');
        }
      });

      searchClearBtn?.addEventListener('click', function() {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchClearBtn.classList.add('hidden');
        searchInput?.focus();
      });
    })();
  </script>
</Base>
