---
import Base from '../../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { BOOKS_METADATA } from '../../../../lib/bible-books';
import { formatVerses, filterDuplicateVerses } from '../../../../lib/bible-format';

export async function getStaticPaths() {
  const allPericopes = await getCollection('biblia');
  const paths = [];

  for (const [testamentKey, books] of Object.entries(BOOKS_METADATA)) {
    const testamentSlug = testamentKey === 'VT' ? 'vechiul-testament' : 'noul-testament';

    for (const book of books) {
      for (let chapter = 1; chapter <= book.chapters; chapter++) {
        const chapterPericopes = allPericopes
          .filter(p =>
            p.data.testament === (testamentKey === 'VT' ? 'OT' : 'NT') &&
            p.data.book_romanian === book.name_ro &&
            p.data.chapter === chapter
          )
          .sort((a, b) => a.data.pericope - b.data.pericope);

        paths.push({
          params: {
            testament: testamentSlug,
            book: book.slug,
            chapter: chapter.toString()
          },
          props: {
            testamentSlug,
            bookMeta: book,
            chapterNum: chapter,
            chapterPericopes
          }
        });
      }
    }
  }

  return paths;
}

const { book: bookSlug } = Astro.params;
const { testamentSlug, bookMeta, chapterNum, chapterPericopes } = Astro.props;

// Track displayed verses to filter overlaps
const displayedVerses = new Set<number>();
---

<Base
  title={`${bookMeta.name_ro} ${chapterNum}`}
  headerTitle={bookMeta.name_ro}
  backHref="/biblia"
  hideBottomNav={true}
  maxWidth="xl"
>
  <div id="chapters-content" class="pt-2 pb-28">

    <!-- Chapter separator -->
    <div class="flex flex-col items-center gap-2 py-6" data-chapter-marker={chapterNum}>
      <div class="w-15 h-0.5 bg-primary/20 dark:bg-[#6366F1]/20 rounded-full"></div>
      <h2 class="font-serif text-xl font-bold text-primary dark:text-[#6366F1]">Capitolul {chapterNum}</h2>
      <div class="w-15 h-0.5 bg-primary/20 dark:bg-[#6366F1]/20 rounded-full"></div>
    </div>

    <!-- Pericopes -->
    <div class="space-y-4">
      {chapterPericopes.map((pericope, i) => {
        // Filter out duplicate verses, then format
        const filteredBody = filterDuplicateVerses(pericope.body, displayedVerses);
        const formattedVerses = formatVerses(filteredBody);

        return (
          <section
            class={`rounded-xl p-5 ${i % 2 === 0 ? 'bg-white dark:bg-[#16161A] border border-gray-200/50 dark:border-[#2A2A2E]' : 'bg-primary/5 dark:bg-[#1A1A1E] border border-primary/10 dark:border-[#2A2A2E]'}`}
            data-chapter={chapterNum}
          >
            <h3 class="text-xl font-bold mb-1 text-primary dark:text-[#FAFAF9]" style="font-family: 'Literata', serif;">
              {pericope.data.pericope_title_ro}
            </h3>
            <div class="text-xs text-slate-600 dark:text-[#6B6B70] mb-4">
              Versetele {pericope.data.verses_start}&ndash;{pericope.data.verses_end}
            </div>
            <div class="prose prose-slate dark:prose-invert prose-base max-w-none prose-p:leading-relaxed prose-p:text-slate-800 dark:prose-p:text-[#FAFAF9] prose-strong:text-slate-900 dark:prose-strong:text-[#FAFAF9]">
              <div set:html={formattedVerses} style="font-family: 'Literata', serif; line-height: 1.8;" />
            </div>
          </section>
        );
      })}
    </div>

    <!-- Sentinel for infinite scroll -->
    <div id="load-sentinel" class="h-1"></div>
  </div>

  <!-- Custom bottom bar -->
  <div class="fixed bottom-0 left-0 right-0 bg-[#FAFAFA] dark:bg-[#0B0B0E] px-2 pt-3" style="padding-bottom: max(1.5rem, env(safe-area-inset-bottom));">
    <div class="flex bg-white dark:bg-[#1A1A1E] rounded-xl border border-gray-200 dark:border-[#2A2A2E] shadow-sm dark:shadow-[0_-4px_24px_rgba(0,0,0,0.25)] h-[54px] p-1 max-w-xl mx-auto">
      <a href="/biblia" class="flex-1 flex items-center justify-center gap-1.5 rounded-lg text-gray-400 dark:text-[#6B6B70]">
        <span class="material-symbols-outlined text-lg">toc</span>
        <span class="text-[11px] font-semibold">Cuprins</span>
      </a>
      {bookMeta.tema_slug && (
        <a href={`/teme/${bookMeta.tema_slug}`} class="flex-1 flex items-center justify-center gap-1.5 rounded-lg text-gray-400 dark:text-[#6B6B70]">
          <span class="material-symbols-outlined text-lg">info</span>
          <span class="text-[11px] font-semibold">Află mai multe</span>
        </a>
      )}
    </div>
  </div>
</Base>

<style>
  /* Verse styling */
  sup {
    vertical-align: super;
    font-size: 0.75em;
    line-height: 0;
  }
</style>

<script define:vars={{ initialChapter: chapterNum, totalChapters: bookMeta.chapters, bookSlug, testament: testamentSlug }}>
  let currentChapter = initialChapter;
  const maxChapter = totalChapters;
  let loadingNext = false;
  const contentContainer = document.getElementById('chapters-content');
  const sentinel = document.getElementById('load-sentinel');

  // Track total pericope count for alternating backgrounds across chapters
  let globalPericopeIndex = document.querySelectorAll('[data-chapter]').length;

  const loadObserver = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !loadingNext && currentChapter < maxChapter) {
      loadNextChapter();
    }
  }, { rootMargin: '400px' });

  if (sentinel) {
    loadObserver.observe(sentinel);
  }

  async function loadNextChapter() {
    loadingNext = true;
    const nextChap = currentChapter + 1;

    try {
      const res = await fetch(`/biblia/api/${testament}/${bookSlug}/${nextChap}.json`);
      const data = await res.json();

      // Build chapter separator
      const separatorHtml =
        '<div class="flex flex-col items-center gap-2 py-6" data-chapter-marker="' + data.chapterNum + '">' +
          '<div class="w-15 h-0.5 bg-primary/20 dark:bg-[#6366F1]/20 rounded-full"></div>' +
          '<h2 class="font-serif text-xl font-bold text-primary dark:text-[#6366F1]">Capitolul ' + data.chapterNum + '</h2>' +
          '<div class="w-15 h-0.5 bg-primary/20 dark:bg-[#6366F1]/20 rounded-full"></div>' +
        '</div>';

      // Build pericopes with alternating backgrounds
      let pericopesHtml = '<div class="space-y-4">';
      for (let i = 0; i < data.pericopes.length; i++) {
        const p = data.pericopes[i];
        const idx = globalPericopeIndex + i;
        const isEven = idx % 2 === 0;
        const bgClass = isEven
          ? 'bg-white dark:bg-[#16161A] border border-gray-200/50 dark:border-[#2A2A2E]'
          : 'bg-primary/5 dark:bg-[#1A1A1E] border border-primary/10 dark:border-[#2A2A2E]';

        pericopesHtml +=
          '<section class="rounded-xl p-5 ' + bgClass + '" data-chapter="' + data.chapterNum + '">' +
            '<h3 class="text-xl font-bold mb-1 text-primary dark:text-[#FAFAF9]" style="font-family: \'Literata\', serif;">' +
              p.title +
            '</h3>' +
            '<div class="text-xs text-slate-600 dark:text-[#6B6B70] mb-4">' +
              'Versetele ' + p.versesStart + '\u2013' + p.versesEnd +
            '</div>' +
            '<div class="prose prose-slate dark:prose-invert prose-base max-w-none prose-p:leading-relaxed prose-p:text-slate-800 dark:prose-p:text-[#FAFAF9] prose-strong:text-slate-900 dark:prose-strong:text-[#FAFAF9]">' +
              '<div style="font-family: \'Literata\', serif; line-height: 1.8;">' + p.versesHtml + '</div>' +
            '</div>' +
          '</section>';
      }
      pericopesHtml += '</div>';

      // Insert before sentinel
      const fragment = document.createElement('div');
      fragment.innerHTML = separatorHtml + pericopesHtml;

      while (fragment.firstChild) {
        sentinel.parentNode.insertBefore(fragment.firstChild, sentinel);
      }

      globalPericopeIndex += data.pericopes.length;
      currentChapter = nextChap;
    } catch (e) {
      console.error('Failed to load chapter', nextChap, e);
    }

    loadingNext = false;
  }
</script>
