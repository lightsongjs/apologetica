---
import Base from '../../layouts/Base.astro';
import { BOOKS_METADATA } from '../../lib/bible-books';

// Short display names for books with long Romanian names
const SHORT_NAMES: Record<string, string> = {
  'deuteronomul': 'Deuteron.',
  'judecatori': 'Judecăt.',
  '1-paralipomena': 'I Paral.',
  '2-paralipomena': 'II Paral.',
  'ecclesiastul': 'Ecclesiast.',
  'faptele-apostolilor': 'Fapte',
  '1-tesaloniceni': 'I Tesal.',
  '2-tesaloniceni': 'II Tesal.',
  'ecclesiasticul': 'Ecclesiastic.',
  'apocalipsa': 'Apocalipsa',
};

function displayName(slug: string, name_ro: string): string {
  return SHORT_NAMES[slug] || name_ro;
}

const vtBooks = BOOKS_METADATA.VT.map(book => ({
  slug: book.slug,
  name: displayName(book.slug, book.name_ro),
  fullName: book.name_ro,
  testament: 'VT',
  chapters: book.chapters,
}));

const ntBooks = BOOKS_METADATA.NT.map(book => ({
  slug: book.slug,
  name: displayName(book.slug, book.name_ro),
  fullName: book.name_ro,
  testament: 'NT',
  chapters: book.chapters,
}));
---

<Base title="Biblia Ortodoxă" headerTitle="Biblia" backHref="/" activeTab="biblia">
  <div class="pt-4 pb-6">
    <!-- In-page search bar (hidden by default) -->
    <div id="bible-search-wrapper" class="hidden mb-4">
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">search</span>
        <input
          type="text"
          id="bible-search-input"
          placeholder="Caută o carte..."
          class="w-full pl-10 pr-10 py-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-900 placeholder:text-gray-400 outline-none focus:border-primary/40 focus:ring-2 focus:ring-primary/10"
          autocomplete="off"
        />
        <button id="bible-search-close" class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- Vechiul Testament -->
    <p class="text-xs font-bold tracking-widest uppercase text-primary/70 font-sans mb-2" data-section="vt">Vechiul Testament</p>
    <div class="grid grid-cols-4 gap-2">
      {vtBooks.map(book => (
        <button
          type="button"
          class="book-card bg-white rounded-lg border border-gray-200 p-3 flex items-center justify-center min-h-[52px] hover:border-primary/40 hover:shadow-sm active:bg-primary/5 transition-all cursor-pointer"
          data-book-slug={book.slug}
          data-testament={book.testament}
          data-chapters={book.chapters}
          data-full-name={book.fullName}
        >
          <span class="text-xs font-medium text-gray-900 text-center leading-tight" style="font-family: 'Literata', serif;">{book.name}</span>
        </button>
      ))}
    </div>

    <!-- Noul Testament -->
    <p class="text-xs font-bold tracking-widest uppercase text-primary/70 font-sans mb-2 mt-6" data-section="nt">Noul Testament</p>
    <div class="grid grid-cols-4 gap-2">
      {ntBooks.map(book => (
        <button
          type="button"
          class="book-card bg-white rounded-lg border border-gray-200 p-3 flex items-center justify-center min-h-[52px] hover:border-primary/40 hover:shadow-sm active:bg-primary/5 transition-all cursor-pointer"
          data-book-slug={book.slug}
          data-testament={book.testament}
          data-chapters={book.chapters}
          data-full-name={book.fullName}
        >
          <span class="text-xs font-medium text-gray-900 text-center leading-tight" style="font-family: 'Literata', serif;">{book.name}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Chapter Popup Overlay -->
  <div id="chapter-popup-overlay" class="fixed inset-0 bg-black/40 z-50 hidden"></div>

  <!-- Chapter Popup Bottom Sheet -->
  <div id="chapter-popup" class="fixed bottom-0 left-0 right-0 z-50 bg-white rounded-t-2xl shadow-2xl translate-y-full transition-transform duration-300 ease-out flex flex-col" style="height: 65vh;">
    <!-- Drag handle -->
    <div class="flex justify-center pt-3 pb-1 flex-shrink-0">
      <div class="w-10 h-1 bg-gray-300 rounded-full"></div>
    </div>
    <!-- Header -->
    <div class="flex items-center justify-between px-5 pb-3 flex-shrink-0">
      <h3 id="popup-book-name" class="text-xl font-bold text-gray-900" style="font-family: 'Literata', serif;"></h3>
      <button id="popup-close" class="w-9 h-9 flex items-center justify-center bg-gray-100 rounded-full hover:bg-gray-200 transition-colors">
        <span class="material-symbols-outlined text-lg text-gray-500">close</span>
      </button>
    </div>
    <!-- Chapter grid (scrollable) -->
    <div id="popup-chapters" class="grid grid-cols-6 gap-2 px-5 pb-8 overflow-y-auto flex-1 min-h-0 content-start">
    </div>
  </div>

  <script>
    function initBibliaPage() {
      const overlay = document.getElementById('chapter-popup-overlay');
      const popup = document.getElementById('chapter-popup');
      const popupBookName = document.getElementById('popup-book-name');
      const popupChapters = document.getElementById('popup-chapters');
      const popupClose = document.getElementById('popup-close');
      const bookCards = document.querySelectorAll('.book-card');
      const bottomNav = document.getElementById('bottom-nav');
      const searchWrapper = document.getElementById('bible-search-wrapper');
      const searchInput = document.getElementById('bible-search-input') as HTMLInputElement | null;
      const searchCloseBtn = document.getElementById('bible-search-close');
      const headerSearchBtn = document.getElementById('header-search-btn');

      if (!overlay || !popup || !popupBookName || !popupChapters) return;

      function getTestamentPath(testament: string): string {
        return testament === 'VT' ? 'vechiul-testament' : 'noul-testament';
      }

      function openPopup(slug: string, testament: string, chapters: number, fullName: string) {
        popupBookName.textContent = fullName;
        const testamentPath = getTestamentPath(testament);
        let html = '';
        for (let i = 1; i <= chapters; i++) {
          html += `<a href="/biblia/${testamentPath}/${slug}/${i}" class="bg-gray-50 rounded-lg border border-gray-200 h-12 flex items-center justify-center text-sm font-medium text-gray-900 hover:bg-primary hover:text-white hover:border-primary transition-colors">${i}</a>`;
        }
        popupChapters.innerHTML = html;

        overlay.classList.remove('hidden');
        void popup.offsetHeight;
        popup.classList.remove('translate-y-full');
        popup.classList.add('translate-y-0');
        document.body.style.overflow = 'hidden';
        if (bottomNav) bottomNav.style.display = 'none';
      }

      function closePopup() {
        popup.classList.remove('translate-y-0');
        popup.classList.add('translate-y-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
        if (bottomNav) bottomNav.style.display = '';
      }

      bookCards.forEach(card => {
        card.addEventListener('click', () => {
          const el = card as HTMLElement;
          openPopup(
            el.dataset.bookSlug!,
            el.dataset.testament!,
            parseInt(el.dataset.chapters!, 10),
            el.dataset.fullName!
          );
        });
      });

      popupClose?.addEventListener('click', closePopup);
      overlay.addEventListener('click', closePopup);

      // In-page search for books
      function openBibleSearch() {
        if (searchWrapper && searchInput) {
          searchWrapper.classList.remove('hidden');
          searchInput.focus();
        }
      }

      function closeBibleSearch() {
        if (searchWrapper && searchInput) {
          searchWrapper.classList.add('hidden');
          searchInput.value = '';
          filterBooks('');
        }
      }

      function filterBooks(query: string) {
        const q = query.toLowerCase().replace(/[ăâ]/g, 'a').replace(/[îï]/g, 'i').replace(/[șş]/g, 's').replace(/[țţ]/g, 't');
        bookCards.forEach(card => {
          const el = card as HTMLElement;
          const name = (el.dataset.fullName || '').toLowerCase().replace(/[ăâ]/g, 'a').replace(/[îï]/g, 'i').replace(/[șş]/g, 's').replace(/[țţ]/g, 't');
          el.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
      }

      // Intercept header search button to open in-page search instead
      if (headerSearchBtn) {
        headerSearchBtn.replaceWith(headerSearchBtn.cloneNode(true));
        const newBtn = document.getElementById('header-search-btn');
        newBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openBibleSearch();
        });
      }

      searchCloseBtn?.addEventListener('click', closeBibleSearch);
      searchInput?.addEventListener('input', (e) => {
        filterBooks((e.target as HTMLInputElement).value);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (!overlay.classList.contains('hidden')) {
            closePopup();
          } else if (searchWrapper && !searchWrapper.classList.contains('hidden')) {
            closeBibleSearch();
          }
        }
      });
    }

    // Run on initial load and after View Transitions
    initBibliaPage();
    document.addEventListener('astro:page-load', initBibliaPage);
  </script>
</Base>
