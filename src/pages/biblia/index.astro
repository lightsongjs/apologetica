---
import Base from '../../layouts/Base.astro';
import { TESTAMENT_STATS, BOOKS_METADATA } from '../../lib/bible-books';

const testaments = [
  {
    slug: 'vechiul-testament',
    name: 'Vechiul Testament',
    icon: 'auto_stories',
    count: TESTAMENT_STATS.VT,
    description: 'Legea, Profeții și Scrierile',
  },
  {
    slug: 'noul-testament',
    name: 'Noul Testament',
    icon: 'menu_book',
    count: TESTAMENT_STATS.NT,
    description: 'Evanghelii, Fapte și Epistole',
  },
];

// Get all biblical books from metadata (actual Bible books with chapters)
const biblicalBooks = [
  ...BOOKS_METADATA.VT.map(book => ({
    slug: book.slug,
    name: book.name_ro,
    testament: 'vechiul-testament' as const,
    chapters: book.chapters,
    code: book.code,
  })),
  ...BOOKS_METADATA.NT.map(book => ({
    slug: book.slug,
    name: book.name_ro,
    testament: 'noul-testament' as const,
    chapters: book.chapters,
    code: book.code,
  })),
];
---

<Base title="Biblia Ortodoxă" headerTitle="Biblia Ortodoxă" backHref="/" activeNav="home">
  <!-- Search Bar -->
  <div class="mb-4 opacity-0" style="animation: fadeIn 0.4s ease-out forwards;">
    <div class="relative">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-primary/40 text-xl">search</span>
      <input
        type="text"
        id="search-input"
        placeholder="Caută cărți biblice (Ioan, Isaia, Facerea...)..."
        class="w-full pl-11 pr-4 py-3 rounded-xl border border-primary/20 bg-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all text-sm"
      />
    </div>
  </div>

  <!-- Cards Grid -->
  <div id="cards-grid" class="grid grid-cols-1 gap-2">
    <!-- Testaments (shown by default) -->
    {testaments.map((testament, i) => (
      <a
        href={`/biblia/${testament.slug}`}
        class="item-card testament-card group bg-white rounded-xl p-3 border border-primary/10 hover:border-primary/30 transition-all duration-300 shadow-sm hover:shadow-md flex items-center gap-3 opacity-0"
        style={`animation: fadeIn 0.4s ease-out ${(i + 1) * 0.05}s forwards;`}
        data-name={testament.name.toLowerCase()}
        data-type="testament"
      >
        <!-- Icon -->
        <div class="w-10 h-10 flex-shrink-0 bg-primary/10 rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <span class="material-symbols-outlined text-xl">{testament.icon}</span>
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
          <h3 class="font-bold text-sm mb-0.5 group-hover:text-primary transition-colors" style="font-family: 'Literata', serif;">{testament.name}</h3>
          <p class="text-xs text-primary/60 truncate">{testament.count} {testament.count === 1 ? 'carte' : 'cărți'} · {testament.description}</p>
        </div>

        <!-- Chevron -->
        <span class="material-symbols-outlined text-lg text-primary/30 group-hover:translate-x-1 group-hover:text-primary transition-all duration-300 flex-shrink-0">chevron_right</span>
      </a>
    ))}

    <!-- Biblical Books (hidden by default, shown when searching) -->
    {biblicalBooks.map((book, i) => (
      <a
        href={`/biblia/${book.testament}/${book.slug}/1`}
        class="item-card book-card hidden group bg-white rounded-xl p-3 border border-primary/10 hover:border-primary/30 transition-all duration-300 shadow-sm hover:shadow-md flex items-center gap-3"
        data-name={book.name.toLowerCase()}
        data-testament={book.testament}
        data-type="book"
      >
        <!-- Icon -->
        <div class="w-10 h-10 flex-shrink-0 bg-primary/10 rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <span class="material-symbols-outlined text-xl">menu_book</span>
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
          <h3 class="font-bold text-sm mb-0.5 group-hover:text-primary transition-colors" style="font-family: 'Literata', serif;">{book.name}</h3>
          <p class="text-xs text-primary/60">{book.chapters} {book.chapters === 1 ? 'capitol' : 'capitole'}</p>
        </div>

        <!-- Chevron -->
        <span class="material-symbols-outlined text-lg text-primary/30 group-hover:translate-x-1 group-hover:text-primary transition-all duration-300 flex-shrink-0">chevron_right</span>
      </a>
    ))}
  </div>

  <!-- No Results -->
  <div id="no-results" class="hidden text-center py-12">
    <span class="material-symbols-outlined text-primary/20 text-5xl mb-3">search_off</span>
    <p class="text-sm text-gray-500">Nicio carte biblică găsită</p>
  </div>

  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const testamentCards = document.querySelectorAll('.testament-card') as NodeListOf<HTMLElement>;
    const bookCards = document.querySelectorAll('.book-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results') as HTMLElement;

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      if (query === '') {
        // No search query - show only testaments
        testamentCards.forEach(card => {
          card.style.display = 'flex';
          card.classList.remove('hidden');
          visibleCount++;
        });
        bookCards.forEach(card => {
          card.style.display = 'none';
          card.classList.add('hidden');
        });
      } else {
        // Searching - hide testaments, show matching books
        testamentCards.forEach(card => {
          card.style.display = 'none';
          card.classList.add('hidden');
        });

        bookCards.forEach(card => {
          const name = card.dataset.name || '';

          if (name.includes(query)) {
            card.style.display = 'flex';
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.style.display = 'none';
            card.classList.add('hidden');
          }
        });
      }

      if (visibleCount === 0 && query !== '') {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    });
  </script>
</Base>
