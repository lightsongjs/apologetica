---
import { getEntryBySlug } from 'astro:content';

interface Props {
  related?: string[];
  opposed_to?: string[];
  condemned_at?: string;
}

const { related = [], opposed_to = [], condemned_at } = Astro.props;

// Fetch related entries (filter out null values)
const relatedEntries = (await Promise.all(
  related.map(slug => getEntryBySlug('teme', slug).catch(() => null))
)).filter(entry => entry !== null);

const opposedEntries = (await Promise.all(
  opposed_to.map(slug => getEntryBySlug('teme', slug).catch(() => null))
)).filter(entry => entry !== null);

const condemnedEntry = condemned_at
  ? await getEntryBySlug('teme', condemned_at).catch(() => null)
  : null;
---

{(relatedEntries.length > 0 || opposedEntries.length > 0 || condemnedEntry) && (
  <section class="bg-orange-50/30 rounded-xl p-6 border border-slate-200">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-orange-600">explore</span>
      <h2 class="text-xl font-bold text-slate-900">Vezi și</h2>
    </div>

    {relatedEntries.length > 0 && (
      <div class="mb-4 last:mb-0">
        <h3 class="font-semibold mb-3 text-slate-900 text-base">Teme conexe:</h3>
        <ul class="space-y-3">
          {relatedEntries.map(entry => entry && (
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-primary text-sm mt-0.5">arrow_forward</span>
              <div>
                <a href={`/teme/${entry.slug}`} class="text-primary hover:underline font-medium">
                  {entry.data.title}
                </a>
                <p class="text-sm text-slate-600 mt-0.5">{entry.data.summary}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    {opposedEntries.length > 0 && (
      <div class="mb-4 last:mb-0">
        <h3 class="font-semibold mb-3 text-slate-900 text-base">Se opune la:</h3>
        <ul class="space-y-2">
          {opposedEntries.map(entry => entry && (
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-red-500 text-sm">close</span>
              <a href={`/teme/${entry.slug}`} class="text-primary hover:underline font-medium">
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {condemnedEntry && (
      <div>
        <h3 class="font-semibold mb-3 text-slate-900 text-base">Condamnat la:</h3>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-red-600 text-sm">gavel</span>
          <a href={`/teme/${condemnedEntry.slug}`} class="text-primary hover:underline font-medium">
            {condemnedEntry.data.title}
          </a>
        </div>
      </div>
    )}
  </section>
)}
