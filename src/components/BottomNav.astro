---
interface Props {
  activeTab?: "biblia" | "discutii" | "teme" | "persoane" | "locuri" | "none";
}

const { activeTab = "none" } = Astro.props;

const tabs = [
  { id: "biblia", label: "Biblia", icon: "menu_book", href: "/biblia" },
  { id: "discutii", label: "Discuții", icon: "forum", href: "/conversatii" },
  { id: "teme", label: "Teme", icon: "auto_stories", href: "/teme" },
  { id: "persoane", label: "Persoane", icon: "group", href: "/personalitati" },
  { id: "locuri", label: "Locuri", icon: "location_on", href: "/locuri" },
];
---

<nav id="bottom-nav" class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-14 px-2 bg-white/95 dark:bg-[#16161A]/95 backdrop-blur-md border-t border-slate-100 dark:border-[#2A2A2E]" style="padding-bottom: env(safe-area-inset-bottom);">
  {tabs.map((tab) => {
    const isActive = activeTab === tab.id;
    return (
      <a
        href={tab.href}
        class:list={[
          "flex flex-col items-center justify-center transition-colors",
          isActive ? "text-primary" : "text-slate-400 dark:text-[#9C9CA2] hover:text-primary",
        ]}
      >
        <span
          class="material-symbols-outlined text-xl"
          style={isActive ? "font-variation-settings: 'FILL' 1;" : ""}
        >{tab.icon}</span>
        <span class:list={[
          "text-[9px] tracking-tight mt-0.5",
          isActive ? "font-medium" : "",
        ]}>{tab.label}</span>
      </a>
    );
  })}
</nav>
