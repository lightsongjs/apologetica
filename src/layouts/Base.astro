---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import BottomNav from '../components/BottomNav.astro';
// Settings panel handles theme toggle inline

interface Props {
  title: string;
  headerTitle?: string;
  backHref?: string;
  useHistoryBack?: boolean;
  isHomePage?: boolean;
  maxWidth?: 'xl' | 'full';
  activeTab?: string;
  hideBottomNav?: boolean;
}

const {
  title,
  headerTitle,
  backHref,
  useHistoryBack = false,
  isHomePage = false,
  maxWidth = 'xl',
  activeTab,
  hideBottomNav = false,
} = Astro.props;

// No data loading needed - will fetch dynamically via JSON endpoint
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Apologetică Ortodoxă - Răspunsuri rapide pentru conversații" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prevent flash of wrong theme (FOUC) - runs BEFORE any CSS -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme')
          || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.classList.toggle('light', theme === 'light');
      })();
    </script>

    <ViewTransitions />

    <!-- Preconnect to Google Fonts for faster loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Optimized font loading -->
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Inter:wght@100..900&family=Literata:wght@400;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400&display=block" rel="stylesheet" />

    <link rel="preload" href="/search-data.json" as="fetch" crossorigin />
    <title>{title} | Apologetica</title>
  </head>
  <body class="bg-bg dark:bg-[#0B0B0E] text-on-surface dark:text-[#FAFAF9] antialiased min-h-screen flex flex-col">
    <script is:inline>
      // Eagerly fetch search data on every page — shared by home search + header search
      if (!window.__searchDataPromise) {
        window.__searchDataPromise = fetch('/search-data.json').then(r => r.json()).catch(() => null);
      }
    </script>

    <header class="sticky top-0 z-50 bg-bg/80 dark:bg-[#0B0B0E]/80 backdrop-blur-md border-b border-primary/10 dark:border-[#2A2A2E] px-4 py-3">
      <div class={`${maxWidth === 'full' ? 'max-w-7xl' : 'max-w-xl'} mx-auto flex items-center justify-between`}>
        <!-- Normal header content -->
        <div id="header-normal" class="flex items-center gap-2 flex-1 min-w-0">
          {useHistoryBack ? (
            <div class="flex items-center gap-1 -ml-2">
              <button id="history-back-btn" class="text-primary hover:bg-primary/10 p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">arrow_back</span>
              </button>
              <button id="history-forward-btn" class="text-primary hover:bg-primary/10 p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">arrow_forward</span>
              </button>
            </div>
          ) : backHref ? (
            <a href={backHref} class="text-primary hover:bg-primary/10 p-2 -ml-2 rounded-full transition-colors flex items-center justify-center">
              <span class="material-symbols-outlined text-2xl">arrow_back</span>
            </a>
          ) : (
            <span class="material-symbols-outlined text-primary text-3xl">menu_book</span>
          )}
          <h1 class="text-xl font-bold tracking-tight text-primary truncate">{headerTitle || title}</h1>
        </div>

        <!-- Inline search input (hidden by default) -->
        {!isHomePage && (
          <div id="header-search-mode" class="hidden flex-1 items-center gap-2">
            <span class="material-symbols-outlined text-primary/40 text-xl flex-shrink-0">search</span>
            <input
              type="text"
              id="header-search-input"
              placeholder="Caută..."
              class="flex-1 bg-transparent border-none outline-none text-sm text-gray-900 dark:text-[#FAFAF9] placeholder:text-gray-400 dark:placeholder:text-[#6B6B70]"
              autocomplete="off"
            />
            <button id="header-search-close" class="text-primary/60 hover:text-primary p-1 rounded-full hover:bg-primary/10 transition-colors flex-shrink-0">
              <span class="material-symbols-outlined text-xl">close</span>
            </button>
          </div>
        )}

        {!isHomePage && (
          <div id="header-actions" class="flex items-center gap-1">
            <button id="header-search-btn" class="text-primary hover:bg-primary/10 p-2 rounded-full transition-colors items-center justify-center hidden">
              <span class="material-symbols-outlined text-2xl">search</span>
            </button>
            <div class="relative">
              <button id="settings-btn" class="text-primary/70 hover:bg-primary/10 p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">settings</span>
              </button>
              <div id="settings-panel" class="hidden absolute right-0 top-full mt-2 w-56 bg-white dark:bg-[#16161A] rounded-xl shadow-lg border border-slate-100 dark:border-[#2A2A2E] py-2 z-50">
                <div class="px-4 py-2 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-on-surface-variant dark:text-[#6B6B70]">dark_mode</span>
                    <span class="text-sm text-on-surface dark:text-[#FAFAF9]">Mod întunecat</span>
                  </div>
                  <button id="theme-toggle" class="relative w-10 h-5 rounded-full bg-slate-200 dark:bg-primary transition-colors" aria-label="Schimbă tema">
                    <span class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform dark:translate-x-5"></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
        {isHomePage && (
          <div class="flex items-center gap-1">
            <div class="relative">
              <button id="settings-btn" class="text-primary/70 hover:bg-primary/10 p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">settings</span>
              </button>
              <div id="settings-panel" class="hidden absolute right-0 top-full mt-2 w-56 bg-white dark:bg-[#16161A] rounded-xl shadow-lg border border-slate-100 dark:border-[#2A2A2E] py-2 z-50">
                <div class="px-4 py-2 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-on-surface-variant dark:text-[#6B6B70]">dark_mode</span>
                    <span class="text-sm text-on-surface dark:text-[#FAFAF9]">Mod întunecat</span>
                  </div>
                  <button id="theme-toggle" class="relative w-10 h-5 rounded-full bg-slate-200 dark:bg-primary transition-colors" aria-label="Schimbă tema">
                    <span class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform dark:translate-x-5"></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Search results dropdown -->
      {!isHomePage && (
        <div id="header-search-dropdown" class={`hidden ${maxWidth === 'full' ? 'max-w-7xl' : 'max-w-xl'} mx-auto mt-2`}>
          <div id="header-search-results" class="bg-white dark:bg-[#16161A] rounded-xl shadow-lg border border-primary/10 dark:border-[#2A2A2E] max-h-80 overflow-y-auto"></div>
          <div id="header-no-results" class="hidden bg-white dark:bg-[#16161A] rounded-xl shadow-lg border border-primary/10 dark:border-[#2A2A2E] p-6 text-center">
            <span class="material-symbols-outlined text-primary/20 text-3xl">search_off</span>
            <p class="text-xs text-gray-500 dark:text-[#6B6B70] mt-1">Niciun rezultat</p>
          </div>
        </div>
      )}
    </header>

    <main class={`flex-1 ${maxWidth === 'full' ? 'max-w-7xl' : 'max-w-xl'} mx-auto w-full px-4 pt-6 pb-8 ${!hideBottomNav ? 'pb-24' : ''}`}>
      <slot />
    </main>

    <script>
      function initBaseLayout() {
        const historyBackBtn = document.getElementById('history-back-btn');
        historyBackBtn?.addEventListener('click', () => {
          window.history.back();
        });

        const historyForwardBtn = document.getElementById('history-forward-btn');
        historyForwardBtn?.addEventListener('click', () => {
          window.history.forward();
        });

        const path = window.location.pathname;
        const isListPage =
          path === '/conversatii' || path === '/conversatii/' ||
          path === '/teme' || path === '/teme/' ||
          path === '/personalitati' || path === '/personalitati/' ||
          path === '/locuri' || path === '/locuri/' ||
          path === '/conversatii/atheist' || path === '/conversatii/atheist/' ||
          path === '/conversatii/baptist' || path === '/conversatii/baptist/' ||
          path === '/conversatii/martorii-lui-iehova' || path === '/conversatii/martorii-lui-iehova/';

        const headerSearchBtn = document.getElementById('header-search-btn');
        if (headerSearchBtn) {
          headerSearchBtn.style.display = 'flex';

          if (isListPage) {
            // On list pages: scroll to page search input + focus
            const newBtn = headerSearchBtn.cloneNode(true);
            headerSearchBtn.replaceWith(newBtn);
            newBtn.style.display = 'flex';
            newBtn.addEventListener('click', (e) => {
              e.preventDefault();
              const pageSearch = document.getElementById('search-input');
              if (pageSearch) {
                pageSearch.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => pageSearch.focus(), 300);
              }
            });
          }
        }
      }
      initBaseLayout();
      document.addEventListener('astro:page-load', initBaseLayout);

      // Settings panel
      function initSettingsPanel() {
        const btn = document.getElementById('settings-btn');
        const panel = document.getElementById('settings-panel');
        const themeToggle = document.getElementById('theme-toggle');
        if (!btn || !panel) return;

        const newBtn = btn.cloneNode(true);
        btn.replaceWith(newBtn);

        newBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          panel.classList.toggle('hidden');
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
          if (!e.target.closest('#settings-panel') && !e.target.closest('#settings-btn')) {
            panel.classList.add('hidden');
          }
        });

        // Theme toggle
        const newThemeToggle = themeToggle?.cloneNode(true);
        if (themeToggle && newThemeToggle) {
          themeToggle.replaceWith(newThemeToggle);
          newThemeToggle.addEventListener('click', () => {
            const html = document.documentElement;
            const isDark = html.classList.contains('dark');
            const newTheme = isDark ? 'light' : 'dark';
            html.classList.toggle('dark', newTheme === 'dark');
            html.classList.toggle('light', newTheme === 'light');
            localStorage.setItem('theme', newTheme);
          });
        }
      }
      initSettingsPanel();
      document.addEventListener('astro:page-load', initSettingsPanel);
    </script>

    {!isHomePage && (
      <script>
        // Use shared preloaded search data
        let searchData = null;

        // Resolve preloaded data immediately
        if (window.__searchDataPromise) {
          window.__searchDataPromise.then(d => { if (d) searchData = d; });
        }

        function initHeaderSearch() {
          const searchBtn = document.getElementById('header-search-btn');
          const closeBtn = document.getElementById('header-search-close');
          const headerNormal = document.getElementById('header-normal');
          const headerActions = document.getElementById('header-actions');
          const searchMode = document.getElementById('header-search-mode');
          const searchInput = document.getElementById('header-search-input');
          const dropdown = document.getElementById('header-search-dropdown');
          const resultsContainer = document.getElementById('header-search-results');
          const noResultsEl = document.getElementById('header-no-results');

          if (!searchMode || !searchInput) return;

          // Ensure data is loaded (should already be from preload)
          if (!searchData && window.__searchDataPromise) {
            window.__searchDataPromise.then(d => { if (d) searchData = d; });
          }

          function openSearch() {
            document.getElementById('header-normal')?.classList.add('hidden');
            document.getElementById('header-actions')?.classList.add('hidden');
            var sm = document.getElementById('header-search-mode');
            if (sm) {
              sm.classList.remove('hidden');
              sm.classList.add('flex');
            }
            var si = document.getElementById('header-search-input');
            if (si) si.focus();
          }

          function closeSearch() {
            var sm = document.getElementById('header-search-mode');
            if (sm) {
              sm.classList.add('hidden');
              sm.classList.remove('flex');
            }
            document.getElementById('header-normal')?.classList.remove('hidden');
            document.getElementById('header-actions')?.classList.remove('hidden');
            document.getElementById('header-search-dropdown')?.classList.add('hidden');
            var si = document.getElementById('header-search-input');
            if (si) si.value = '';
            var rc = document.getElementById('header-search-results');
            if (rc) rc.innerHTML = '';
            document.getElementById('header-no-results')?.classList.add('hidden');
            // Reset cauta tab highlight
            const cautaTab = document.getElementById('cauta-tab');
            if (cautaTab) {
              cautaTab.classList.remove('bg-primary', 'text-white');
              cautaTab.classList.add('text-gray-400');
            }
          }

          function removeDiacritics(str) {
            return str
              .replace(/[ăâ]/g, 'a').replace(/[ĂÂ]/g, 'A')
              .replace(/[îï]/g, 'i').replace(/[ÎÏ]/g, 'I')
              .replace(/[șş]/g, 's').replace(/[ȘŞ]/g, 'S')
              .replace(/[țţ]/g, 't').replace(/[ȚŢ]/g, 'T');
          }

          function normalize(str) {
            return removeDiacritics(str.toLowerCase());
          }

          function matchesWord(text, q) {
            var n = normalize(text);
            var regex = new RegExp('(?:^|[\\s,;.!?()\\[\\]"„""\'«»\\-–—/])' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
            return regex.test(n);
          }

          function highlightMatch(text, query) {
            if (!query) return text;
            var nq = normalize(query);
            var pattern = '';
            for (var i = 0; i < nq.length; i++) {
              var ch = nq[i];
              if (ch === 'a') pattern += '[aăâĂÂ]';
              else if (ch === 'i') pattern += '[iîïÎÏ]';
              else if (ch === 's') pattern += '[sșşȘŞ]';
              else if (ch === 't') pattern += '[tțţȚŢ]';
              else pattern += ch.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }
            var regex = new RegExp('(?<=^|[\\s,;.!?()\\[\\]"„""\'«»\\-–—/])(' + pattern + ')', 'gi');
            return text.replace(regex, '<mark class="bg-primary/20 text-primary font-bold px-0.5 rounded">$1</mark>');
          }

          function getTestamentPath(testament) {
            return testament === 'VT' ? 'vechiul-testament' : 'noul-testament';
          }

          function performSearch(query) {
            if (!searchData) return;

            var q = normalize(query.trim());

            if (!q) {
              dropdown?.classList.add('hidden');
              if (resultsContainer) resultsContainer.innerHTML = '';
              noResultsEl?.classList.add('hidden');
              return;
            }

            var bookResults = [];
            var convResults = [];
            var temeResults = [];
            var persResults = [];
            var locuriResults = [];

            const { bibleBooks, conversations, teme, personalitati, locuri, denominationLabels } = searchData;

            // Bible books — match only on name, keep canonical order
            var bibleTemaIds = new Set();
            if (bibleBooks) {
              bibleBooks.forEach(function(book) {
                if (matchesWord(book.name, q)) {
                  bookResults.push({
                    icon: 'menu_book', label: book.testament === 'VT' ? 'VT' : 'NT',
                    title: book.name, subtitle: book.chapters + ' capitole',
                    href: '/biblia/' + getTestamentPath(book.testament) + '/' + book.slug + '/1',
                    code: book.code,
                  });
                }
                if (book.tema_slug) bibleTemaIds.add(book.tema_slug);
              });
              bookResults.sort(function(a, b) { return a.code - b.code; });
            }

            // Conversations — match only on title
            conversations.forEach(function(conv) {
              if (matchesWord(conv.title, q)) {
                var denomLabel = denominationLabels[conv.denomination] || conv.denomination;
                var slug = conv.id.replace(/^ro\/[^/]+\//, '').replace('.md', '');
                convResults.push({
                  icon: 'forum', label: denomLabel, title: conv.title,
                  subtitle: null, href: '/conversatii/' + conv.denomination + '/' + slug,
                });
              }
            });
            convResults.sort(function(a, b) { return normalize(a.title).localeCompare(normalize(b.title)); });

            // Teme — match only on title, skip bible book teme
            teme.forEach(function(tema) {
              var temaSlug = tema.id.replace('.md', '');
              if (bibleTemaIds.has(temaSlug)) return;
              if (matchesWord(tema.title, q)) {
                temeResults.push({
                  icon: 'auto_stories', label: null, title: tema.title,
                  subtitle: tema.summary, href: '/teme/' + temaSlug,
                });
              }
            });
            temeResults.sort(function(a, b) { return normalize(a.title).localeCompare(normalize(b.title)); });

            // Personalitati — match only on name
            personalitati.forEach(function(pers) {
              if (matchesWord(pers.name, q)) {
                persResults.push({
                  icon: 'person_pin', label: null, title: pers.name,
                  subtitle: pers.title, href: '/personalitati/' + pers.id.replace('.md', ''),
                  image: pers.image,
                });
              }
            });
            persResults.sort(function(a, b) { return normalize(a.title).localeCompare(normalize(b.title)); });

            // Locuri — match only on name
            locuri.forEach(function(loc) {
              if (matchesWord(loc.name, q)) {
                locuriResults.push({
                  icon: 'location_on', label: null, title: loc.name,
                  subtitle: loc.title, href: '/locuri/' + loc.id.replace('.md', ''),
                });
              }
            });
            locuriResults.sort(function(a, b) { return normalize(a.title).localeCompare(normalize(b.title)); });

            // Final order: bible books > conversations > teme > personalitati > locuri
            var results = bookResults.concat(convResults, temeResults, persResults, locuriResults);

            if (results.length === 0) {
              dropdown?.classList.remove('hidden');
              if (resultsContainer) resultsContainer.innerHTML = '';
              noResultsEl?.classList.remove('hidden');
              return;
            }

            noResultsEl?.classList.add('hidden');
            dropdown?.classList.remove('hidden');

            var oq = query.trim();
            if (resultsContainer) {
              resultsContainer.innerHTML = results.slice(0, 8).map(function(r) {
                var iconHtml = r.image
                  ? '<div class="w-8 h-8 flex-shrink-0 bg-cover bg-center rounded-lg border border-gray-200" style="background-image: url(\'' + r.image + '\')"></div>'
                  : '<div class="w-8 h-8 flex-shrink-0 bg-primary/10 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-base text-primary">' + r.icon + '</span></div>';

                var labelHtml = r.label
                  ? '<span class="text-[9px] font-bold text-primary/60 uppercase tracking-wider">' + r.label + ' · </span>'
                  : '';

                return '<a href="' + r.href + '" class="flex items-center gap-3 px-3 py-2.5 hover:bg-primary/5 transition-colors border-b border-gray-50 last:border-0">'
                  + iconHtml
                  + '<div class="flex-1 min-w-0">'
                  + '<p class="text-sm font-semibold text-gray-900 truncate">' + labelHtml + highlightMatch(r.title, oq) + '</p>'
                  + (r.subtitle ? '<p class="text-xs text-gray-500 truncate">' + highlightMatch(r.subtitle, oq) + '</p>' : '')
                  + '</div>'
                  + '<span class="material-symbols-outlined text-sm text-primary/30">chevron_right</span>'
                  + '</a>';
              }).join('');
            }
          }

          // Use cloneNode trick to remove old event listeners
          const newSearchBtn = searchBtn ? searchBtn.cloneNode(true) : null;
          if (searchBtn && newSearchBtn) {
            searchBtn.replaceWith(newSearchBtn);
            newSearchBtn.addEventListener('click', openSearch);
          }

          const newCloseBtn = closeBtn ? closeBtn.cloneNode(true) : null;
          if (closeBtn && newCloseBtn) {
            closeBtn.replaceWith(newCloseBtn);
            newCloseBtn.addEventListener('click', closeSearch);
          }

          // Re-clone search input to clear old listeners
          const newSearchInput = searchInput.cloneNode(true);
          searchInput.replaceWith(newSearchInput);

          newSearchInput.addEventListener('input', function(e) {
            performSearch(e.target.value);
          });

          newSearchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              var firstLink = resultsContainer?.querySelector('a');
              if (firstLink) {
                e.preventDefault();
                window.location.href = firstLink.getAttribute('href');
              }
            }
          });

          // Store references on window for keydown handler and bottom nav
          window._headerSearch = {
            openSearch,
            closeSearch,
            get searchMode() { return document.getElementById('header-search-mode'); }
          };
        }

        // Global keydown handler (only added once)
        if (!window._headerSearchKeydown) {
          window._headerSearchKeydown = true;
          document.addEventListener('keydown', function(e) {
            var hs = window._headerSearch;
            if (!hs) return;
            if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
              e.preventDefault();
              hs.openSearch();
            }
            if (e.key === 'Escape' && hs.searchMode && !hs.searchMode.classList.contains('hidden')) {
              hs.closeSearch();
            }
          });
          document.addEventListener('click', function(e) {
            var hs = window._headerSearch;
            if (!hs) return;
            if (hs.searchMode && !hs.searchMode.classList.contains('hidden') && !e.target.closest('header') && !e.target.closest('#cauta-tab')) {
              hs.closeSearch();
            }
          });
        }

        initHeaderSearch();
        document.addEventListener('astro:page-load', initHeaderSearch);
      </script>
    )}

    {!hideBottomNav && <BottomNav activeTab={activeTab} />}
  </body>
</html>
